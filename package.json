{
  "name": "netscope",
  "version": "1.0.0",
  "description": "NetScope: diagnóstico de la calidad de conexiones Wi-Fi y móviles (proyecto integrador de Redes I, CUC)",
  "scripts": {
    "dev": "vite",
    "servidor": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "tsc && vite build",
    "start": "npm run build && npm run servidor",
    "prueba": "node --disable-warning=ExperimentalWarning --test pruebas/*.test.js",
    "archivos-prueba": "python3 scripts/archivos-prueba.py public/prueba"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}